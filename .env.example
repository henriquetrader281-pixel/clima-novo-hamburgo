# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@exemplo.com

# Persistência Redis REST (Upstash ou Vercel KV compatível)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Proteção do cron Vercel
CRON_SECRET=

# WeatherKit Apple (a chave .p8 nunca vai para o frontend)
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
